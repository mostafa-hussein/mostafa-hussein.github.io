---
layout: default
---
{% comment %}
  Wraps the theme's CV renderer with a visible download button for the PDF.
{% endcomment %}
{% if page.resume_pdf %}
  <div class="cv-download">
    <a class="btn-home primary" href="{{ page.resume_pdf | relative_url }}" target="_blank" rel="noopener">
      <i class="fa-solid fa-file-pdf"></i>
      Download the PDF resume
    </a>
  </div>
{% endif %}
{% al_folio_cv_render %}
